# TRACE Engine Configuration
# Copy this file to .env and provide your Gemini API Key

# Google Gemini API Key (Required for autonomous critique & synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database Connection URL
# PostgreSQL (Production / Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/trace_db
# SQLite (Local Dev Fallback): sqlite+aiosqlite:///data/trace_app.db
DATABASE_URL=sqlite+aiosqlite:///data/trace_app.db

# CORS Allowed Origins (comma-separated, e.g. https://your-vercel-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=*

# Environment Mode (development / production)
ENVIRONMENT=development
